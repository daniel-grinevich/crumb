# Copy to .env (`just env` does this with random secrets). Never commit .env.

# Header X-API-Key value for the crumb API.
CRUMB_API_KEY=change-me
# Salt for pseudonymising user identifiers. Keep it stable: changing it re-keys every user.
CRUMB_PII_SALT=change-me-to-a-long-random-string

# Optional: Stripe test-mode secret key. Without it the Stripe extract is skipped.
# CRUMB_STRIPE_API_KEY=sk_test_...

# Outside docker these defaults point at the compose ports:
# CRUMB_WAREHOUSE_DSN=postgresql://crumb:crumb@localhost:5440/crumb
# CRUMB_NAVI_DSN=postgresql://crumb_reader:crumb_reader@localhost:5441/navi
# CRUMB_TEMPORAL_ADDRESS=localhost:7233
# CRUMB_REPORTING_TZ=UTC
